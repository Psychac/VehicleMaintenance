# Optional. Defaults for the Supabase connection; users can also enter these in Settings -> Storage.
# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Leave both blank to use on-device SQLite (data stays in this browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ISO currency code used for display
VITE_CURRENCY=INR
